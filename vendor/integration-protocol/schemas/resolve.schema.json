{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocol": {
      "type": "string",
      "const": "job-integrations"
    },
    "schemaVersion": {
      "type": "number",
      "const": 2
    },
    "client": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "capabilities": {
      "maxItems": 128,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
      }
    },
    "scope": {
      "type": "object",
      "properties": {
        "categories": {
          "maxItems": 128,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          }
        },
        "markets": {
          "maxItems": 128,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          }
        }
      },
      "required": [
        "categories",
        "markets"
      ],
      "additionalProperties": false
    },
    "knownRevision": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "protocol",
    "schemaVersion",
    "client",
    "capabilities",
    "scope",
    "knownRevision"
  ],
  "additionalProperties": false
}
