{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "maxItems": 16,
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]{0,63}$"
      },
      "providerId": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
      },
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "resolveUrl": {
        "type": "string",
        "maxLength": 4000,
        "format": "uri"
      },
      "authentication": {
        "type": "string",
        "enum": [
          "none",
          "bearer"
        ]
      },
      "credentialRef": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
      },
      "publicKeys": {
        "type": "object",
        "propertyNames": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "additionalProperties": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "scope": {
        "type": "object",
        "properties": {
          "categories": {
            "maxItems": 128,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
            }
          },
          "markets": {
            "maxItems": 128,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
            }
          }
        },
        "required": [
          "categories",
          "markets"
        ],
        "additionalProperties": false
      },
      "enabled": {
        "type": "boolean"
      },
      "priority": {
        "type": "integer",
        "minimum": 0,
        "maximum": 10000
      }
    },
    "required": [
      "id",
      "providerId",
      "name",
      "resolveUrl",
      "authentication",
      "publicKeys",
      "scope",
      "enabled",
      "priority"
    ],
    "additionalProperties": false
  }
}
