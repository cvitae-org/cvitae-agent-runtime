{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocol": {
      "type": "string",
      "const": "job-provider-directory"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "directoryId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "website": {
      "type": "string",
      "maxLength": 4000,
      "format": "uri"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "validUntil": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "entries": {
      "maxItems": 128,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "providerId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "website": {
            "type": "string",
            "maxLength": 4000,
            "format": "uri"
          },
          "descriptorUrl": {
            "type": "string",
            "maxLength": 4000,
            "format": "uri"
          },
          "providerSchemaVersion": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 100
          },
          "scope": {
            "type": "object",
            "properties": {
              "categories": {
                "maxItems": 128,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
                }
              },
              "markets": {
                "maxItems": 128,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
                }
              }
            },
            "required": [
              "categories",
              "markets"
            ],
            "additionalProperties": false
          },
          "capabilities": {
            "maxItems": 128,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
            }
          },
          "requiredCapabilities": {
            "maxItems": 128,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
            }
          }
        },
        "required": [
          "id",
          "providerId",
          "name",
          "description",
          "website",
          "descriptorUrl",
          "providerSchemaVersion",
          "scope",
          "capabilities",
          "requiredCapabilities"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "protocol",
    "schemaVersion",
    "directoryId",
    "name",
    "website",
    "generatedAt",
    "validUntil",
    "entries"
  ],
  "additionalProperties": false
}
