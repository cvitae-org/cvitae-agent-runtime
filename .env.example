# cvitae-agent-runtime holds the API keys, because it is the only process that
# talks to a model. cvitae itself never sees the keys set here, and neither does
# the browser. A caller that supplies its own key per run is the one exception:
# it is spent for that call only and kept nowhere.
# Every value below is optional and shown with its default.

# Which provider drives generation. One of: openrouter, huggingface, openai,
# local. Defaults to local, which needs no credential at all.
AI_PROVIDER=local

# Overrides the provider's default generation model.
# AI_MODEL=

# Credentials. Only the one matching AI_PROVIDER is needed; "local" needs none.
# OPENROUTER_API_KEY=
# HF_TOKEN=
# OPENAI_API_KEY=

# Where embeddings come from. Kept separate from AI_PROVIDER because the two
# rarely coincide: OpenRouter serves no embedding endpoint at all, so a setup
# generating on OpenRouter still embeds locally through Ollama.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=nomic-embed-text

# The local OpenAI-compatible server. Ollama's default; LM Studio uses :1234/v1,
# llama.cpp and vLLM :8080/v1. Must stay on loopback — see providers/resolve.ts.
LOCAL_BASE_URL=http://localhost:11434/v1

# Where the runtime keeps its state: one SQLite file holding runs, events,
# documents and the chunk index. Defaults to ~/.cvitae/runtime.db.
# CVITAE_DB=

# Optional. Where cvitae-scrapper is listening.
#
# analyze_offer reads a URL through the scraper first and falls back to a plain
# GET when nothing answers, so leaving this unset costs only the boards a plain
# GET cannot read — which is most of the interesting ones. It also supplies the
# fields the board published as data (salary, company, skills), which are worth
# more than the same values inferred by a small model from the same page.
#
# Defaults to http://127.0.0.1:8787. Set it to empty to skip the attempt.
# SCRAPER_URL=http://127.0.0.1:8787

# Required when SCRAPER_URL is enabled. Use the same random value configured in
# cvitae-scrapper (at least 32 characters). It is sent only as a Bearer header.
# SCRAPER_API_TOKEN=

# Optional. Where cvitae-mail is listening.
#
# Drafting job applications from the user's own mailbox. It runs as a separate
# process because of what the credential is: a Gmail token is read access to
# everything the user was ever sent plus the ability to write as them, and
# keeping it out of the process that holds the CV and the provider keys means a
# leak in one is not a leak in both.
#
# Nothing here is registered as a tool, and mail never reaches a run. This
# runtime puts collected offer text — written by whoever posted the offer — into
# model context; an outbound channel reachable from a tool loop is an
# exfiltration path with a plausible cover story. See src/effects/mail.ts, and
# the two boundary rules that make it structural rather than a convention.
#
# Defaults to http://127.0.0.1:8789. Set it to empty to disable it.
# MAIL_URL=http://127.0.0.1:8789

# Which engine the web tier of verify_recipient uses.
#
# auto is the default and means "the best engine that is actually usable": Brave
# when a key is set, DuckDuckGo when one is not. Naming an engine outright
# disables that substitution, so a deployment that has paid for a key fails
# loudly rather than quietly falling back to scraping a search page.
# auto | brave | duckduckgo | off
# WEB_SEARCH=auto

# Optional. A Brave Search API key.
#
# What it buys: the employer's own website when the board published only their
# name, their careers page, and whichever page carries a contact address. Two of
# the three boards this project reads name a company and no website, so without
# a search the verification has nothing to check the posting against.
#
# It costs no model call. The engine is asked for URLs, the URLs are fetched,
# and the same regex that reads the posting reads the pages. A search result is
# a pointer: a title or a snippet can move a page up the fetch queue and can
# never name a recipient.
#
# Free tier is 2,000 queries a month at one query per second, which is what the
# spacing between queries is sized for. https://brave.com/search/api/
# BRAVE_API_KEY=

# Optional. Which market to search, as a two-letter country code.
#
# Defaults to pl, because the boards this project reads are Polish and the
# difference is not cosmetic: an unqualified search for a small Polish
# employer's name returns the American company with the same one.
# WEB_SEARCH_COUNTRY=pl

# Optional. How long one search query may take, in milliseconds. A check makes
# two or three. Defaults to 10000.
# WEB_SEARCH_TIMEOUT_MS=10000

# Optional. An alternative path to the env file itself, read at startup.
# Without this override the runtime reads `.env` from the launch working
# directory and then from its own package root, without overwriting variables
# already supplied by the process.
# ENV_FILE=
