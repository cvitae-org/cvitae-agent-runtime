{
  "name": "cvitae-agent-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server/index.ts",
    "serve": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json",
    "lint": "eslint",
    "test:ai-logging": "node --import tsx --test scripts/aiLogging.test.ts",
    "test": "node --import tsx --test scripts/*.test.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^2.0.68",
    "@ai-sdk/openai-compatible": "^1.0.48",
    "ai": "^5.0.235",
    "fastify": "^5.2.1",
    "unpdf": "^1.8.1",
    "zod": "^4.1.12"
  },
  "optionalDependencies": {
    "@lancedb/lancedb": "^0.37.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20",
    "eslint": "^9",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "typescript-eslint": "^8.24.0"
  }
}
