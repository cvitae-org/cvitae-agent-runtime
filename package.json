{
  "name": "cvitae-agent-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=20.12"
  },
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json",
    "lint": "eslint",
    "boundaries": "depcruise src --config .dependency-cruiser.cjs",
    "test": "node --import tsx --test scripts/*.test.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm boundaries && pnpm test",
    "cli": "tsx src/adapters/cli/main.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^2.0.68",
    "@ai-sdk/openai-compatible": "^1.0.48",
    "ai": "^5.0.235",
    "better-sqlite3": "^13.0.3",
    "unpdf": "^1.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.9.1",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "typescript-eslint": "^8.24.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
